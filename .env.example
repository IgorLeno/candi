# Data source: "fixture" (default, local JSON) or "sheets" (real registry, read-only).
JOB_SEARCH_DATA_SOURCE=fixture

# Only used when JOB_SEARCH_DATA_SOURCE=sheets.
JOB_SEARCH_SHEET_ID=
# Read-only service account (spreadsheets.readonly, Viewer on the Sheet). Never commit it.
# Path to the JSON key outside the repository.
GOOGLE_SA_JSON_PATH=
# Alternative: base64 of the JSON key (wins over the path when both are set).
GOOGLE_SA_JSON_B64=

# No login: `pnpm dev`/`pnpm start` listen on 127.0.0.1 only (any port) and the panel refuses any
# request not addressed to localhost, 127.0.0.1 or [::1]. It cannot be opened from another device.

# Bot dispatch from the panel (optional, off by default). The panel runs job-search's
# hermes/browsers/dispatch.py with a fixed argv; it never sees the Hermes gateway token.
# JOB_SEARCH_DISPATCH_ENABLED=true
# Absolute path of the job-search checkout.
# JOB_SEARCH_REPO=/home/<user>/Projetos/job-search
# Python used to run the dispatcher (stdlib only; default python3).
# JOB_SEARCH_DISPATCH_PYTHON=python3
